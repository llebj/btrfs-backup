# btrfs-backup #

# Do not delete the first line!
# It is used to indicate that this file is owned by the btrfs-backup program.

[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = Creating btrfs snapshot of {{ Source }} ...
When = {{ Type }}
Exec = /usr/local/bin/btrfs-snapshot {{ Source }} {{ Destination }}
Depends = btrfs-progs
AbortOnFail
